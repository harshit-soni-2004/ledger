# Copy to .env and replace every change-me value. .env is git-ignored and is read by both
# docker compose and the application (spring.config.import). Real environment variables win.
# Passwords must not contain quotes (single or double) or backslashes.

MYSQL_ROOT_PASSWORD=change-me-root

LEDGER_DB_HOST_PORT=3306
LEDGER_DB_URL=jdbc:mysql://localhost:3306/ledger?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true

LEDGER_DB_MIGRATION_USER=ledger_migrator
LEDGER_DB_MIGRATION_PASSWORD=change-me-migrator

LEDGER_DB_APP_USER=ledger_app
LEDGER_DB_APP_PASSWORD=change-me-app

LEDGER_HTTP_PORT=8080

# Optional: seeds one ADMIN client on startup when no active admin exists. Format: lk_ followed by
# 43 base62 characters. Generate a fresh random value; never reuse an example.
# LEDGER_BOOTSTRAP_ADMIN_KEY=
